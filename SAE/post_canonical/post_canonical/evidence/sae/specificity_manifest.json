{
  "purpose": "Measure whether SAE candidate features are selective for their target linguistic variable rather than broadly responding across many controlled transformations.",
  "specificity_data": "train association matrices only",
  "candidate_filter": "train maxT FWER significant and validation same direction",
  "test_used_for_selection": false,
  "specificity_metrics": [
    "rank among 40 variables",
    "ratio versus strongest other variable",
