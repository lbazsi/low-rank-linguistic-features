  ],
  "outputs": {
    "candidate_specificity": "artifacts/linguistic_feature_eval/summary/cross_variable_specificity.csv",
    "feature_reuse": "artifacts/linguistic_feature_eval/summary/feature_reuse.csv",
    "trainval_selected_features": "artifacts/linguistic_feature_eval/summary/trainval_selected_features.csv",
    "mean_variable_similarity": "artifacts/linguistic_feature_eval/summary/variable_similarity_mean_train.npy",
    "final_variable_similarity": "artifacts/linguistic_feature_eval/summary/variable_similarity_final_train.npy"
  }
}
